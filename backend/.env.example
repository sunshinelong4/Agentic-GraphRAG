# Agentic-GraphRAG 后端环境变量模板
#
# 用法：
#   cd backend
#   cp .env.example .env
#   然后填入真实密钥
#
# 注意：`.env` 已加入 .gitignore，不会入库。切勿把真实密钥提交到仓库。

# =============================================================================
# 大模型（必需）
# 用于：信息抽取（LangExtract）、关系抽取、Agent 问答
# =============================================================================
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-chat

# =============================================================================
# 向量检索（可选；不配置则只有图谱检索能力，Agent 会自动降级）
# 用于：Embedding（阿里云百炼兼容 OpenAI 协议）
# =============================================================================
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# =============================================================================
# PDF 解析（可选；不配置则无法使用 PDF 上传解析）
# MinerU: https://mineru.net
# =============================================================================
MINERU_API_KEY=

# =============================================================================
# 向量库
# =============================================================================
# chroma 或 qdrant
VECTOR_STORE_BACKEND=chroma
# ChromaDB 本地持久化目录（留空则用 backend/chroma_db_chapter5）
CHROMA_PERSIST_DIR=
# Qdrant（仅当 VECTOR_STORE_BACKEND=qdrant 时需要；留空使用内存模式）
QDRANT_URL=
QDRANT_API_KEY=

# =============================================================================
# 知识图谱（可选，均有合理默认值）
# =============================================================================
# 图谱持久化路径（留空则用 backend/outputs/knowledge_graph_store.json）
GRAPH_PERSIST_PATH=
# 多跳检索默认跳数
GRAPH_HOPS=2
# 子图节点预算（防止上下文爆炸）
GRAPH_MAX_NODES=30
# 单文档关系数上限
GRAPH_MAX_RELATIONS=60

# =============================================================================
# Agent（可选）
# =============================================================================
# 引用校验不通过时的最大重试轮数（verify -> rewrite 循环）
AGENT_MAX_ATTEMPTS=2
# 工具调用轮数上限（plan -> tools -> assess -> plan 循环）
AGENT_MAX_TOOL_ROUNDS=3
# 是否用 LLM 判断证据充分性（关闭则退化为纯启发式，确定性且零额外调用）
AGENT_USE_LLM_ASSESSOR=true
# 引用可接地比例的通过阈值（低于该值触发改写重试）
AGENT_GROUNDED_THRESHOLD=0.85
# 证据"薄"的阈值（字符数）：低于该值才请 LLM 判官复核
# 调大 = 更频繁复核（更贵但可能补到漏检）；调到 0 = 非聚合问题永不复核
AGENT_THIN_EVIDENCE_CHARS=400

# =============================================================================
# LLM 单价（用于成本估算，单位：元 / 百万 token）
#
# 刻意留空：各家模型单价会变，代码里写死迟早变成错误信息。
# 留空时 API 与评测报告只给 token 数，cost 返回 null 并标记 cost_configured=false。
# 请按官方定价页填写后再依赖费用数字。
# =============================================================================
LLM_PRICE_INPUT_PER_1M=0
LLM_PRICE_OUTPUT_PER_1M=0

# =============================================================================
# 服务
# =============================================================================
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Shared knowledge base authentication and single-process admission control
AUTH_ENABLED=true
AUTH_SESSION_TTL_SECONDS=28800
MAX_INFLIGHT_REQUESTS=64
MAX_EXPENSIVE_REQUESTS=8
MAX_USER_CONCURRENCY=2
USER_REQUESTS_PER_MINUTE=30
LOGIN_REQUESTS_PER_MINUTE=10
MAX_AUTH_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=45
